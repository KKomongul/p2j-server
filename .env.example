# P2J 서버 환경변수 예시
# 이 파일만 커밋한다. 실제 값이 담긴 .env 는 절대 커밋하지 않는다.
# 실키는 팀 Notion 비공개 페이지 또는 Discord DM 으로 공유한다.
#
# 사용법: cp .env.example .env  (Windows PowerShell: Copy-Item .env.example .env)

# --- 서버 ---
APP_ENV=development
PORT=8000

# --- DB (docker compose 기본값) ---
DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5432/p2j

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (§1.6: access 30분, refresh 14일) ---
# 운영에서는 반드시 바꾼다. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-32b
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_DAYS=14

# --- 도메인 규칙 ---
# 하루 경계 시각. 4 = 매일 04:00 KST 에 날짜가 넘어간다 (BR-01)
SERVICE_DAY_START_HOUR=4

# --- 배치 (04-backend-v1 §5.9) ---
# 하루가 04:00 에 바뀌므로 그 직후에 전일을 판정한다 (KST 기준).
# 인스턴스를 여러 개로 늘리면 잡이 중복 실행된다. 그때는 false 로 끄고
# 외부 cron 에서 `uv run python -m app.jobs` 를 부른다.
BATCH_ENABLED=true
BATCH_HOUR=4
BATCH_MINUTE=10

# --- CORS ---
# 운영에서 허용할 origin 을 콤마로 구분. 비우면 운영에서 CORS 를 열지 않는다. 개발은 항상 허용.
CORS_ORIGINS=

# --- 외부 서비스 (해당 기능 구현 시 필수) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Firebase 서비스 계정 키 파일 경로. 파일 자체는 커밋 금지 (.gitignore 에 있음)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# --- 제한 ---
AI_PARSE_DAILY_LIMIT=30
